[Unit]
Description=GradeSync API Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=gradesync
Group=gradesync
WorkingDirectory=/home/gradesync/GradeSync/api
Environment="PATH=/home/gradesync/GradeSync/venv/bin"
EnvironmentFile=/home/gradesync/GradeSync/.env

# 使用Gunicorn运行（生产推荐）
ExecStart=/home/gradesync/GradeSync/venv/bin/gunicorn \
    -w 4 \
    -k uvicorn.workers.UvicornWorker \
    --bind 127.0.0.1:8000 \
    --access-logfile /var/log/gradesync/access.log \
    --error-logfile /var/log/gradesync/error.log \
    --log-level info \
    app:app

Restart=always
RestartSec=10

# 安全设置
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
